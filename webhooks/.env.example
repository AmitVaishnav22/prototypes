# Copy to .env and fill in your cloud provider credentials.
# .env is gitignored. These same names work as real environment variables,
# and as user-secrets keys (without the __ separator).
#
#   dotnet user-secrets set "RabbitMq:ConnectionString" "amqps://..."
#
# The app refuses to start without these, so a bad deploy fails immediately
# instead of silently running with no broker.

# --- RabbitMQ (CloudAMQP, RabbitMQ Cloud, etc.) ---
# Use amqps:// on managed providers; it turns on TLS automatically.
RabbitMq__ConnectionString=amqps://<user>:<password>@<host>:<port>/<vhost>
RabbitMq__Exchange=newsletter
RabbitMq__Queue=newsletter.github-release
RabbitMq__RoutingKey=github-release

# --- Inbound webhook signature verification ---
# Used to verify the X-Hub-Signature-256 header (HMAC-SHA256 over the raw body).
# Must match the secret configured on the calling side.
Webhook__Secret=<at-least-32-characters>